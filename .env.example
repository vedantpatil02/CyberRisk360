POSTGRES_USER=cyberrisk360
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cyberrisk360

# Generate a real one: openssl rand -hex 32
# The app refuses to start with this placeholder when ENVIRONMENT != development/local/test
SECRET_KEY=changeme-generate-a-real-secret

ENVIRONMENT=production

# Comma-separated list of origins allowed to make browser cross-origin
# requests (e.g. a frontend's URL). Empty = no cross-origin requests
# allowed. Only matters for browser clients; server-to-server calls
# are unaffected.
CORS_ALLOWED_ORIGINS=

# Trust the X-Forwarded-For header for the client IP (rate limiting,
# audit trail). Enable ONLY behind a trusted reverse proxy that sets it,
# otherwise clients can spoof their IP. Default false.
TRUST_PROXY_HEADERS=false

# Logging. LOG_FORMAT=json emits one JSON object per line for log
# aggregators; anything else uses a human-readable console format.
LOG_LEVEL=INFO
LOG_FORMAT=console

# Directory for uploaded scan reports. Point at a mounted volume in a
# container so uploads survive restarts. Defaults to backend/uploads.
UPLOAD_DIR=

# Optional NVD API key (https://nvd.nist.gov/developers/request-an-api-key)
# for CVE enrichment. Raises the request-rate limit from 5 to 50 per
# 30s. Leave unset to use the stricter unauthenticated limit.
NVD_API_KEY=
